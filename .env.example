# ----------------LLM Providers-------------------------------------------------
# Get Gemini key free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM routing: auto (Gemini → Groq fallback) | gemini | groq
LLM_PROVIDER=auto

# ── Web Search ─────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Docker Compose sets this automatically — only change for external Postgres
DATABASE_URL=postgresql+asyncpg://archon:archonsecret@db:5432/archon_db

# ── Storage paths (managed by Docker) ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
